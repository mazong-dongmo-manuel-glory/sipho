rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ─── Receipts ────────────────────────────────────────────────────────────
    // Pattern: receipts/{uid}/{receiptId}.jpg
    match /receipts/{uid}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024  // 5 MB max
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType == 'application/pdf');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // ─── Avatars (future) ───────────────────────────────────────────────────
    match /avatars/{uid}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 1 * 1024 * 1024  // 1 MB max
        && request.resource.contentType.matches('image/.*');
    }

    // ─── Public assets (animations, lessons media) ──────────────────────────
    match /public/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if false; // Admin SDK only
    }
  }
}

