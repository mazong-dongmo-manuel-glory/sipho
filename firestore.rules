rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }

    function isCurrency(code) {
      return code is string && code.size() == 3;
    }

    function isCountryCode(code) {
      return code is string && code.size() == 2;
    }

    function isIsoDate(value) {
      return value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    // Fields on users/{uid} that only Cloud Functions / Admin SDK may write.
    // - xp / level / gems / streak / league...: gamification state
    // - redeemedReferralCode / referredByUid: one-shot referral bonus (clearing them would let a
    //   user redeem again)
    // - completedLessonIds / lastActiveDate: progress written by completeLesson / onTransactionWrite
    function serverOnlyUserFields() {
      return [
        'plan',
        'xp',
        'level',
        'gems',
        'seeds',
        'streak',
        'league',
        'leagueId',
        'weeklyXp',
        'badges',
        'admin',
        'role',
        'redeemedReferralCode',
        'referredByUid',
        'completedLessonIds',
        'lastActiveDate'
      ];
    }

    function touchesServerOnlyUserFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(serverOnlyUserFields());
    }

    // IANA zone id (e.g. "Asia/Kolkata") + current UTC offset in minutes (half-hour zones OK).
    function validUserTimeFields(data) {
      return (!('timezone' in data)
              || (data.timezone is string && data.timezone.size() > 0 && data.timezone.size() <= 64))
        && (!('utcOffsetMinutes' in data)
            || (data.utcOffsetMinutes is int
                && data.utcOffsetMinutes >= -720
                && data.utcOffsetMinutes <= 840));
    }

    function validUserIncomeField(data) {
      return !('monthlyIncomeCents' in data)
        || (data.monthlyIncomeCents is int
            && data.monthlyIncomeCents >= 0
            && data.monthlyIncomeCents < 1000000000);
    }

    // ─── Internal Functions collections (Admin SDK only) ────────────────────
    match /_idempotency/{key} {
      allow read, write: if false;
    }

    match /_rateLimits/{key} {
      allow read, write: if false;
    }

    // ─── Users ──────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'displayName',
          'countryCode',
          'currency',
          'locale',
          'timezone',
          'onboardingDone'
        ])
        && !request.resource.data.keys().hasAny(serverOnlyUserFields())
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && isCountryCode(request.resource.data.countryCode)
        && isCurrency(request.resource.data.currency)
        && request.resource.data.locale in ['fr', 'en']
        && request.resource.data.timezone is string
        && validUserTimeFields(request.resource.data)
        && request.resource.data.onboardingDone is bool
        && validUserIncomeField(request.resource.data);

      allow update: if isOwner(uid)
        && !touchesServerOnlyUserFields()
        && (!('displayName' in request.resource.data)
            || (request.resource.data.displayName is string
                && request.resource.data.displayName.size() <= 80))
        && (!('countryCode' in request.resource.data)
            || isCountryCode(request.resource.data.countryCode))
        && (!('currency' in request.resource.data)
            || isCurrency(request.resource.data.currency))
        && (!('locale' in request.resource.data)
            || request.resource.data.locale in ['fr', 'en'])
        && validUserTimeFields(request.resource.data)
        && validUserIncomeField(request.resource.data);

      allow delete: if false; // Use deleteAccount callable

      // ── Game state: CLIENT READ ONLY, Functions write ──────────────────
      match /game/state {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Fixed expenses ──────────────────────────────────────────────────
      match /fixedExpenses/{expenseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.amountCents < 100000000
          && request.resource.data.dueDay is int
          && request.resource.data.dueDay >= 1
          && request.resource.data.dueDay <= 31
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 80
          && request.resource.data.category is string
          && request.resource.data.category.size() <= 40
          && (!('payMode' in request.resource.data)
              || request.resource.data.payMode in ['auto', 'manual'])
          && (!('type' in request.resource.data)
              || request.resource.data.type in ['bill', 'envelope'])
          && (!('active' in request.resource.data)
              || request.resource.data.active is bool);
      }

      // ── Monthly aggregates: Functions write ──────────────────────────────
      match /months/{monthId} {
        allow read: if isOwner(uid);
        allow write: if false;

        match /fixed/{fixedId} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }

      // ── Transactions ─────────────────────────────────────────────────────
      match /transactions/{txId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents > 0
          && request.resource.data.amountCents < 10000000
          && request.resource.data.source in ['manual', 'receipt']
          && isCurrency(request.resource.data.currency)
          && isIsoDate(request.resource.data.date)
          && request.resource.data.date >= '2000-01-01'
          && request.resource.data.date <= '2100-12-31'
          && request.resource.data.category is string
          && request.resource.data.category.size() > 0
          && request.resource.data.category.size() <= 40
          && (!('amountMainCents' in request.resource.data)
              || (request.resource.data.amountMainCents is int
                  && request.resource.data.amountMainCents > 0
                  && request.resource.data.amountMainCents < 100000000))
          && (!('merchant' in request.resource.data)
              || (request.resource.data.merchant is string
                  && request.resource.data.merchant.size() <= 80))
          && (!('note' in request.resource.data)
              || (request.resource.data.note is string
                  && request.resource.data.note.size() <= 200));
      }

      // ── Budgets ──────────────────────────────────────────────────────────
      match /budgets/{category} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && request.resource.data.limitCents is int
          && request.resource.data.limitCents > 0
          && request.resource.data.limitCents < 100000000;
      }

      // ── Receipts: client can create upload metadata, Functions write parsed ─
      match /receipts/{receiptId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && request.resource.data.storagePath is string
          && request.resource.data.storagePath.matches('^receipts/' + uid + '/[A-Za-z0-9_.-]+$');
        allow update, delete: if false;
      }

      // ── Goals ────────────────────────────────────────────────────────────
      match /goals/{goalId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && (!('targetCents' in request.resource.data)
              || (request.resource.data.targetCents is int
                  && request.resource.data.targetCents > 0
                  && request.resource.data.targetCents < 1000000000));
      }

      // ── Quests: Functions write ──────────────────────────────────────────
      match /quests/{questId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Lesson progress / history: Functions write ──────────────────────
      match /lessonProgress/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /lessonHistory/{lessonId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Insights: Functions write, client can only dismiss ──────────────
      match /insights/{insightId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dismissed'])
          && request.resource.data.dismissed is bool;
        allow create, delete: if false;
      }

      // ── Alerts: Functions write, client can mark read ───────────────────
      match /alerts/{alertId} {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      // ── Devices (FCM tokens) ─────────────────────────────────────────────
      match /devices/{deviceId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && deviceId.size() <= 80
          && request.resource.data.fcmToken is string
          && request.resource.data.fcmToken.size() > 10
          && request.resource.data.fcmToken.size() <= 4096
          && request.resource.data.active is bool
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 32;
      }

      // ── Notification state ───────────────────────────────────────────────
      match /notifState/state {
        allow read: if isOwner(uid);
        allow update: if isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prefs', 'preferredHour'])
          && (!('preferredHour' in request.resource.data)
              || (request.resource.data.preferredHour is int
                  && request.resource.data.preferredHour >= 0
                  && request.resource.data.preferredHour <= 23));
        allow create, delete: if false;
      }

      match /notifState/{bucket} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      // ── Generic subcollections: read-only for owner, no client writes ───
      match /{sub=**} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // ─── Public Profiles ────────────────────────────────────────────────────
    // No money amounts; written exclusively by Cloud Functions.
    match /publicProfiles/{uid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Friendships ────────────────────────────────────────────────────────
    match /friendships/{pairId} {
      allow read: if isSignedIn()
        && resource.data.users.hasAny([request.auth.uid]);
      allow write: if false;
    }

    // ─── Leagues ────────────────────────────────────────────────────────────
    match /leagues/{leagueId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Referrals ──────────────────────────────────────────────────────────
    match /referrals/{code} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Country packs ──────────────────────────────────────────────────────
    match /countries/{code} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Economy data ────────────────────────────────────────────────────────
    match /economy/{code} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── FX rates ────────────────────────────────────────────────────────────
    match /fx/{doc} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // ─── Lessons ────────────────────────────────────────────────────────────
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Quest templates ────────────────────────────────────────────────────
    match /questTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ─── Notification templates ─────────────────────────────────────────────
    match /notifTemplates/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
